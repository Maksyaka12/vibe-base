# Serverless functions (frontend/api), set in Vercel. Never commit real values.

# Alchemy key for NFT and transfer lookups
ALCHEMY_API_KEY=

# Upstash Redis for the schedule, published rounds and agent settings (either pair works).
# Without it, `npm run dev` keeps data in frontend/.data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated admin wallets allowed to publish schedules and banners
SCHEDULE_ADMINS=

# Privy, for agent wallet signing
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=

# Optional: daily agent limits. Defaults: 5 ETH, 100M VIBE, 10,000 USDC
AGENT_DAILY_LIMIT_ETH=
AGENT_DAILY_LIMIT_VIBE=
AGENT_DAILY_LIMIT_USDC=

# Optional client overrides (Vite). Each one defaults to the mainnet value in the code.
VITE_PRIVY_SIGNER_ID=
VITE_ACHIEVEMENTS_CONTRACT_ADDRESS=
VITE_CHECKIN_CONTRACT_ADDRESS=
VITE_HOLDER_DISTRIBUTOR_V2=
VITE_ROYALTY_DISTRIBUTOR_V2=
